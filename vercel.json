{
  "cleanUrls": true,
  "trailingSlash": true,
  "outputDirectory": "dist",
  "buildCommand": "python3 build.py",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/invitation/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/invitation/:token/:document/",
      "destination": "/api/invitation?token=:token&document=:document"
    },
    {
      "source": "/invitation/:token/",
      "destination": "/api/invitation?token=:token"
    }
  ],
  "functions": {
    "api/invitation.js": {
      "maxDuration": 60
    }
  }
}
