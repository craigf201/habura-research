{
  "cleanUrls": true,
  "trailingSlash": true,
  "outputDirectory": "dist",
  "buildCommand": "python3 build.py",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
